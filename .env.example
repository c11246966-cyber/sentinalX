# ==============================================================================
# SentinelX Platform Configuration
# ==============================================================================
# Copy this file to .env and configure values before starting the services.
# NEVER commit the actual .env file containing sensitive credentials to git.

# ------------------------------------------------------------------------------
# Environment & Server
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SentinelX SOC & Threat Detection Platform"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Security & Authentication (Argon2 / JWT)
# ------------------------------------------------------------------------------
# Secret key for JWT signing (uses built-in dev default if omitted in development)
SECRET_KEY=sentinelx-insecure-development-secret-key-change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx_secure_dev_password
POSTGRES_DB=sentinelx_db

# ------------------------------------------------------------------------------
# Cache & Message Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Optional: Set REDIS_PASSWORD only when Redis requires authentication.
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Rate Limiting & Audit Logging
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Threat Intelligence Providers (Optional - empty by default)
# ------------------------------------------------------------------------------
# Do not require these keys to start SentinelX.
# When empty or omitted, external lookups are gracefully disabled and SentinelX
# uses its internal curated threat-intelligence feed and local RFC1918 classification.
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
OTX_API_KEY=""

# Threat Intelligence Caching & Timeouts (Safe Defaults)
THREAT_INTEL_CACHE_TTL=3600
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_TIMEOUT_S=5.0
THREAT_INTEL_TIMEOUT_SECONDS=5.0


